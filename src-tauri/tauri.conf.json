{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "countdown-widget",
    "version": "0.1.0",
    "identifier": "com.justa.countdown-widget",
    "build": {
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Countdown",
                "skipTaskbar": true,
                "resizable": false,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
